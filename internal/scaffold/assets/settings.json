{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(./.env)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/id_rsa)",
      "Read(**/id_ed25519)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git reset --hard*)",
      "Bash(acline auth *)",
      "Bash(acline snapshot import*)",
      "Bash(acline project add*)",
      "Bash(sqlite3 *)",
      "Edit(.claude/settings.json)",
      "Edit(.claude/settings.local.json)",
      "Read(~/.acline/**)",
      "Edit(~/.acline/**)"
    ]
  },
  "env": {
    "ACLINE_ACTOR_TYPE": "agent",
    "ACLINE_ACTOR": "claude-code"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "acline hook session-start" }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          { "type": "command", "command": "acline hook pre-compact" }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "acline hook stop" }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          { "type": "command", "command": "acline hook session-end" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit|Bash",
        "hooks": [
          { "type": "command", "command": "acline hook post-tool-use" }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Read|Edit|Write|Grep|Glob|Bash|NotebookEdit|WebFetch|WebSearch|Task|mcp__.*",
        "hooks": [
          { "type": "command", "command": "acline hook pre-tool-use || exit 2" }
        ]
      }
    ]
  }
}
